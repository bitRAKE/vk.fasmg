; Shared callback state. Severity/type filtering belongs to each Vulkan messenger.
DEBUG_ALL_SEVERITIES := VK_DEBUG_UTILS_MESSAGE_SEVERITY_VERBOSE_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_SEVERITY_INFO_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT
DEBUG_ALL_TYPES := VK_DEBUG_UTILS_MESSAGE_TYPE_GENERAL_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_TYPE_VALIDATION_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_TYPE_PERFORMANCE_BIT_EXT
DEBUG_WARNINGS := VK_DEBUG_UTILS_MESSAGE_SEVERITY_WARNING_BIT_EXT or VK_DEBUG_UTILS_MESSAGE_SEVERITY_ERROR_BIT_EXT
DEBUG_INFO := DEBUG_WARNINGS or VK_DEBUG_UTILS_MESSAGE_SEVERITY_INFO_BIT_EXT
DEBUG_DEMO_ID := 44424700h
DEBUG_CONSOLE := 0
DEBUG_DEBUGGER := 1
DEBUG_FILE := 2

struct DebugSink
	kind dd ?
	demoMask dd ?
	handle dq ?                     ; WriteFile handle, or -1 for DEBUG_DEBUGGER.
	?label dq ?
ends
